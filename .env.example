# ── LLM DeepSeek (API OpenAI-compatible) ──
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_API_KEY_ALT=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Capa de datos sigap-mcp ──
SIGAP_MCP_URL=http://127.0.0.1:8100
SIGAP_MCP_TOKEN=token-del-cliente-agentes

# ── Servidor del agente ──
AGENT_PORT=8200

# ── WhatsApp Cloud API (Meta Graph v23.0) ──
WHATSAPP_TOKEN=token-de-acceso-de-meta
WHATSAPP_PHONE_NUMBER_ID=id-del-numero-de-prueba
WHATSAPP_VERIFY_TOKEN=token-de-verificacion-del-webhook
WHATSAPP_APP_SECRET=secret-de-la-app-meta
